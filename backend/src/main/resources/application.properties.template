# MongoDB Atlas Configuration Template
# Copy this file to application.properties and fill in your details

spring.application.name=RK Food Backend
server.port=8080

# MongoDB Configuration - MongoDB Atlas
# Get your connection string from MongoDB Atlas Dashboard
# Format:mongodb+srv://king:<Kollebharathteja>@weathercluster.fbpth27.mongodb.net/?appName=WeatherCluster
# Example: mongodb+srv://rkfoods_admin:YourPassword123@rkfoods-cluster.abc123.mongodb.net/rkfood

spring.data.mongodb.uri=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/rkfood?retryWrites=true&w=majority
spring.data.mongodb.auto-index-creation=true

# File Upload Configuration
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# CORS Configuration
spring.web.cors.allowed-origins=http://localhost:5173
spring.web.cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS
spring.web.cors.allowed-headers=*
spring.web.cors.allow-credentials=true